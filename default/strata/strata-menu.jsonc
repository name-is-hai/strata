  "trigger.toggle": {"icon":"󰔎","label":"Toggle"},
  "trigger.toggle.osd": {"plugin":"strata.osd","icon":"󰍹","label":"On-screen display","aliases":["OSD","status popups","volume popup","language popup"],"description":"Show volume, brightness, language and lock-key popups","action":"strata-toggle-osd"},
  "trigger.toggle.cast": {"plugin":"strata.cast","icon":"󰄙","label":"Cast","aliases":["wireless display","miracast","airplay","chromecast","cast discovery"],"description":"Show Cast and discover nearby receivers","action":"strata-toggle-cast"},
  "trigger.toggle.shortcut-guide": {"plugin":"strata.shortcut-guide","icon":"󰌌","label":"Shortcut Guide","aliases":["keyboard hints","keybinding guide","omakeez"],"description":"Hold Super to show available shortcuts","action":"strata-shortcut-guide toggle"},
  "trigger.toggle.idle-lock": {"plugin":"strata.idle","icon":"󰅶","label":"Stay Awake","action":"strata-toggle-idle"},
