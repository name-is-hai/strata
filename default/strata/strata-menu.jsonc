  "trigger.image-convert": {"icon":"󰋩","label":"Convert or resize image","aliases":["image tools","pictures","compress image","jpg","png","webp"],"description":"Export a compressed JPG, PNG or WebP copy","action":"strata-image-convert"},
  "trigger.capture": {"icon":"","label":"Capture"},
