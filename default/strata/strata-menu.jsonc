  "trigger.capture.screenrecord.app.desktop-audio": {"icon":"󰕾","label":"Desktop audio","action":"strata-capture-screenrecording --select-app --with-desktop-audio"},
  "trigger.capture.screenrecord.app.microphone-audio": {"icon":"󰍬","label":"Microphone","action":"strata-capture-screenrecording --select-app --with-microphone-audio"},
  "trigger.capture.screenrecord.app.desktop-and-mic": {"icon":"󰍬","label":"Desktop + microphone","action":"strata-capture-screenrecording --select-app --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.fullscreen": {"icon":"󰍹","label":"Monitor"},
