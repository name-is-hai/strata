{
  "bar": {
    "centerAnchor": "strata.clock",
    "enabled": true,
    "id": "strata.bar",
    "layout": {
      "center": [
        {
          "id": "strata.privacy",
          "showMicrophone": false
        },
        {
          "discoveryEnabled": false,
          "id": "strata.cast",
          "lastTab": "screen"
        },
        {
          "id": "strata.indicators"
        },
        {
          "id": "strata.system-update"
        },
        {
          "birthYear": 0,
          "format": "d MMM yyyy HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "strata.clock",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "allowDefaultActionOnCardClick": true,
          "alwaysShow": false,
          "badge": "Highlight",
          "browserGrouping": "hostname",
          "compact": true,
          "displayMode": "active",
          "displayName": "",
          "id": "strata.notifications",
          "offerSnoozeWhenSharing": true,
          "playSound": true,
          "popupPosition": "top-center",
          "showCountdown": true
        }
      ],
      "left": [
        {
          "id": "strata.menu"
        },
        {
          "id": "strata.workspaces"
        },
        {
          "id": "strata.media"
        }
      ],
      "right": [
        {
          "hidden": [
            "Fcitx",
            "blueman",
            "udiskie"
          ],
          "id": "strata.tray",
          "pinned": []
        },
        {
          "id": "strata.language-input"
        },
        {
          "id": "strata.audio"
        },
        {
          "id": "strata.bluetooth"
        },
        {
          "id": "strata.network"
        },
        {
          "id": "strata.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "disabledPlugins": [
    "strata.active-window",
    "strata.spacer"
  ],
  "idle": {
    "lock": 300
  },
  "plugins": [
    {
      "desktopLayoutVersion": 1,
      "dim": 50,
      "groupByApp": true,
      "id": "strata.stage-control",
      "macShortcuts": true,
      "threeFingerLeft": "off",
      "threeFingerRight": "off"
    }
  ],
  "version": 1
}
