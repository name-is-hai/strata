#!/usr/bin/env python3
# strata:summary=List configured Fcitx5 input methods
"""Print Fcitx5 input methods configured in the active profile."""
import json
import os
import re
from pathlib import Path

profile = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "fcitx5" / "profile"
text = profile.read_text() if profile.is_file() else ""
methods = []
for section in re.finditer(r"(?ms)^\[Groups/\d+/Items/\d+\][^\n]*\n(.*?)(?=^\[[^\n]+\]|\Z)", text):
    name = re.search(r"^Name=(.+)$", section.group(1), re.M)
    if name and name.group(1).strip() not in methods:
        methods.append(name.group(1).strip())
print(json.dumps(methods))
