#!/usr/bin/env bash

# strata:summary=View and edit an image in Strata Snip
# strata:args=<image-file>

set -euo pipefail

if (( $# != 1 )) || [[ ! -f $1 || ! -r $1 ]]; then
  echo 'Usage: strata-open-image <image-file>' >&2
  exit 2
fi

# Desktop applications can start outside UWSM, so prefer the packaged path.
snip_bin="${STRATA_SNIP_BIN:-/usr/share/strata/bin/strata-snip}"
if [[ -z ${STRATA_SNIP_BIN:-} && ! -x $snip_bin ]] && command -v strata-snip >/dev/null 2>&1; then
  snip_bin=$(command -v strata-snip)
fi
if [[ ! -x $snip_bin ]]; then
  echo 'strata-open-image: Strata Snip is not installed' >&2
  exit 1
fi

exec "$snip_bin" --editor window --file "$1"
