#!/usr/bin/env bash

# strata:summary=View and edit an image in Strata Snip
# strata:args=<image-file>

set -euo pipefail

if (( $# != 1 )) || [[ ! -f $1 || ! -r $1 ]]; then
  echo 'Usage: strata-open-image <image-file>' >&2
  exit 2
fi

# Desktop applications do not necessarily inherit the interactive shell PATH.
# Keep local development builds usable without putting a user's path in a
# system desktop entry; packaged installations resolve the binary from PATH.
if [[ -x $HOME/.local/bin/strata-snip ]]; then
  snip_bin=$HOME/.local/bin/strata-snip
elif command -v strata-snip >/dev/null 2>&1; then
  snip_bin=$(command -v strata-snip)
else
  echo 'strata-open-image: Strata Snip is not installed' >&2
  exit 1
fi

exec "$snip_bin" --editor window --file "$1"
