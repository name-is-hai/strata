#!/usr/bin/env bash
# Root-only helper for the virtual AP and its Strata-specific client block list.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mac_valid() { [[ ${1:-} =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; }
firewall_init() {
  if nft list table inet strata_hotspot >/dev/null 2>&1; then
    # Upgrade the table created by the earlier hotspot implementation.
    nft list set inet strata_hotspot allowed_clients >/dev/null 2>&1 && return 0
    nft delete table inet strata_hotspot
  fi
  nft -f - <<'RULES'
table inet strata_hotspot {
  set blocked_clients { type ether_addr; }
  set allowed_clients { type ether_addr; }
  chain input {
    type filter hook input priority filter; policy accept;
    iifname "ap0" ether saddr @blocked_clients drop
    jump allow_only_input
  }
  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "ap0" ether saddr @blocked_clients drop
    jump allow_only_forward
  }
  chain allow_only_input {}
  chain allow_only_forward {}
}
RULES
}
sync_lists() {
  local allowed_csv=${1:-} blocked_csv=${2:-} allow_only=${3:-0} mac
  firewall_init
  nft flush set inet strata_hotspot allowed_clients
  nft flush set inet strata_hotspot blocked_clients
  if [[ -n $allowed_csv ]]; then
    IFS=',' read -r -a allowed_macs <<< "$allowed_csv"
    for mac in "${allowed_macs[@]}"; do
      mac_valid "$mac" && nft add element inet strata_hotspot allowed_clients "{ ${mac,,} }"
    done
  fi
  if [[ -n $blocked_csv ]]; then
    IFS=',' read -r -a blocked_macs <<< "$blocked_csv"
    for mac in "${blocked_macs[@]}"; do
      mac_valid "$mac" && nft add element inet strata_hotspot blocked_clients "{ ${mac,,} }"
    done
  fi
  nft flush chain inet strata_hotspot allow_only_input
  nft flush chain inet strata_hotspot allow_only_forward
  if [[ $allow_only == 1 ]]; then
    nft add rule inet strata_hotspot allow_only_input iifname ap0 ether saddr '!=' @allowed_clients drop
    nft add rule inet strata_hotspot allow_only_forward iifname ap0 ether saddr '!=' @allowed_clients drop
  fi
}
case ${1:-} in
  add)
    station=${2:-}
    [[ $station =~ ^[[:alnum:]_.-]+$ && -e /sys/class/net/$station/phy80211 ]] || {
      echo 'The active Wi-Fi interface could not be identified.' >&2; exit 2; }
    phy=$(basename "$(readlink -f "/sys/class/net/$station/phy80211")")
    iw phy "$phy" info | grep -Eq '^[[:space:]]+\* AP$' || {
      echo 'This Wi-Fi adapter does not support access-point mode.' >&2; exit 1; }
    ip link show ap0 >/dev/null 2>&1 || iw phy "$phy" interface add ap0 type __ap
    ip link set ap0 up
    sync_lists "${3:-}" "${4:-}" "${5:-0}"
    ;;
  del)
    ip link show ap0 >/dev/null 2>&1 && iw dev ap0 del || true
    nft delete table inet strata_hotspot >/dev/null 2>&1 || true
    ;;
  block)
    mac_valid "${2:-}" || { echo 'Invalid client MAC address.' >&2; exit 2; }
    firewall_init
    nft add element inet strata_hotspot blocked_clients "{ ${2,,} }" 2>/dev/null || true
    iw dev ap0 station del "${2,,}" 2>/dev/null || true
    ;;
  unblock)
    mac_valid "${2:-}" || { echo 'Invalid client MAC address.' >&2; exit 2; }
    nft delete element inet strata_hotspot blocked_clients "{ ${2,,} }" 2>/dev/null || true
    ;;
  allow)
    mac_valid "${2:-}" || { echo 'Invalid client MAC address.' >&2; exit 2; }
    firewall_init
    nft add element inet strata_hotspot allowed_clients "{ ${2,,} }" 2>/dev/null || true
    ;;
  disallow)
    mac_valid "${2:-}" || { echo 'Invalid client MAC address.' >&2; exit 2; }
    nft delete element inet strata_hotspot allowed_clients "{ ${2,,} }" 2>/dev/null || true
    iw dev ap0 station del "${2,,}" 2>/dev/null || true
    ;;
  allow-only-on)
    firewall_init
    nft flush chain inet strata_hotspot allow_only_input
    nft flush chain inet strata_hotspot allow_only_forward
    nft add rule inet strata_hotspot allow_only_input iifname ap0 ether saddr '!=' @allowed_clients drop
    nft add rule inet strata_hotspot allow_only_forward iifname ap0 ether saddr '!=' @allowed_clients drop
    ;;
  allow-only-off)
    nft list table inet strata_hotspot >/dev/null 2>&1 || exit 0
    nft flush chain inet strata_hotspot allow_only_input
    nft flush chain inet strata_hotspot allow_only_forward
    ;;
  kick)
    mac_valid "${2:-}" || { echo 'Invalid client MAC address.' >&2; exit 2; }
    iw dev ap0 station del "${2,,}"
    ;;
  *) echo 'Usage: strata-hotspot-ap {add <station-interface>|del|block|unblock|allow|disallow|kick <mac>|allow-only-on|allow-only-off}' >&2; exit 2 ;;
esac
