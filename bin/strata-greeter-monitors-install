#!/usr/bin/python3
"""Publish validated connector states for the separate login compositor."""
import json
import os
from pathlib import Path
import re
import sys
import tempfile

DESTINATION = Path('/etc/strata/disabled-monitors')
CONNECTOR = re.compile(r'[A-Za-z0-9_.-]{1,128}\Z')


def merge_disabled(previous, rows):
    if not isinstance(rows, list) or not 1 <= len(rows) <= 64:
        raise ValueError('Expected 1–64 monitor states')
    disabled = {name for name in previous if CONNECTOR.fullmatch(name)}
    seen = set()
    for row in rows:
        if not isinstance(row, dict) or set(row) != {'name', 'disabled'}:
            raise ValueError('Expected connector name and disabled state')
        name = row['name']
        if not isinstance(name, str) or not CONNECTOR.fullmatch(name) or name in seen:
            raise ValueError('Invalid or duplicate connector name')
        if type(row['disabled']) is not bool:
            raise ValueError('Expected a boolean disabled state')
        seen.add(name)
        if row['disabled']:
            disabled.add(name)
        else:
            disabled.discard(name)
    if all(row['disabled'] for row in rows):
        raise ValueError('At least one display must remain enabled')
    return sorted(disabled)


def main():
    if os.geteuid() != 0:
        raise ValueError('Run this helper through pkexec')
    if len(sys.argv) != 2 or len(sys.argv[1]) > 65536:
        raise ValueError('Expected monitor states as JSON')
    previous = DESTINATION.read_text().splitlines() if DESTINATION.exists() else []
    names = merge_disabled(previous, json.loads(sys.argv[1]))
    content = ''.join(name + '\n' for name in names)
    if DESTINATION.exists() and DESTINATION.read_text() == content:
        return
    DESTINATION.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.disabled-monitors.', dir=DESTINATION.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
            os.fchmod(stream.fileno(), 0o644)
            os.fchown(stream.fileno(), 0, 0)
        os.replace(temporary, DESTINATION)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
