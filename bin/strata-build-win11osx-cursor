#!/usr/bin/env python3
# strata:summary=Rebuild the bundled Win11OSX cursor theme
"""Package the author's Win11OSX XCursor archive for Hyprcursor, without redrawing it.
Usage: bin/strata-build-win11osx-cursor EXTRACTED_THEME OUTPUT_DIRECTORY
Requires hyprcursor-util and libcairo; no xcur2png or image conversion packages.
"""
from pathlib import Path
import collections
import ctypes as C
import hashlib
import json
import runpy
import shutil
import struct
import subprocess
import sys
import zlib

# Pre-render discrete sizes to avoid Hyprcursor's clipped PNG downscaling.
# cairo_paint covers the whole destination after scaling; no scaled clip rect.
RENDER_SIZES = (24, 28, 32, 36, 40, 44, 48, 50, 56, 60, 64, 72, 80, 88, 96)
cairo = C.CDLL("libcairo.so.2")
for name, result, args in [
    ("cairo_image_surface_create", C.c_void_p, [C.c_int, C.c_int, C.c_int]),
    ("cairo_image_surface_create_for_data", C.c_void_p, [C.c_void_p, C.c_int, C.c_int, C.c_int, C.c_int]),
    ("cairo_create", C.c_void_p, [C.c_void_p]),
    ("cairo_scale", None, [C.c_void_p, C.c_double, C.c_double]),
    ("cairo_set_source_surface", None, [C.c_void_p, C.c_void_p, C.c_double, C.c_double]),
    ("cairo_paint", None, [C.c_void_p]),
    ("cairo_surface_write_to_png", C.c_int, [C.c_void_p, C.c_char_p]),
    ("cairo_destroy", None, [C.c_void_p]),
    ("cairo_surface_destroy", None, [C.c_void_p]),
]:
    function = getattr(cairo, name)
    function.restype, function.argtypes = result, args

def render_frame(data, frame, size, path):
    pixels = C.create_string_buffer(data[frame['pixel_offset']:frame['pixel_offset'] + frame['pixel_bytes']])
    source_surface = cairo.cairo_image_surface_create_for_data(pixels, 0, frame['width'], frame['height'], frame['width'] * 4)
    target_surface = cairo.cairo_image_surface_create(0, size, size)
    context = cairo.cairo_create(target_surface)
    try:
        cairo.cairo_scale(context, size / frame['width'], size / frame['height'])
        cairo.cairo_set_source_surface(context, source_surface, 0, 0)
        cairo.cairo_paint(context)
        assert cairo.cairo_surface_write_to_png(target_surface, str(path).encode()) == 0
    finally:
        cairo.cairo_destroy(context)
        cairo.cairo_surface_destroy(target_surface)
        cairo.cairo_surface_destroy(source_surface)

source, output = map(lambda s: Path(s).resolve(), sys.argv[1:])
repo = Path(subprocess.check_output(
    [str(Path(__file__).resolve().parent / 'strata-cmd-repo-root')], text=True
).strip())
parser = runpy.run_path(str(repo / 'third_party/wiggle/scripts/wiggle-discover-cursor'))
work = output / 'working'
theme = output / 'Win11OSX'
work.mkdir(parents=True, exist_ok=True)
(theme / 'cursors').mkdir(parents=True, exist_ok=True)
(work / 'manifest.hl').write_text('name = Win11OSX\ndescription = Win11OSX by MOYASH; Linux format conversion by Strata\nversion = 1.1\ncursors_directory = hyprcursors\n')
shutil.copy2(source / 'index.theme', theme / 'index.theme')
groups = collections.defaultdict(list)
for path in sorted((source / 'cursors').iterdir()):
    groups[hashlib.sha256(path.read_bytes()).hexdigest()].append(path.name)
report = []
preferred = ['left_ptr', 'pointer', 'text', 'wait', 'progress', 'help', 'crosshair',
             'not-allowed', 'grab', 'grabbing', 'move', 'ns-resize', 'ew-resize',
             'nwse-resize', 'nesw-resize', 'col-resize', 'row-resize']
for names in groups.values():
    canonical = next((name for name in preferred if name in names),
                     next((name for name in names if '-' in name), names[0]))
    data = (source / 'cursors' / canonical).read_bytes()
    frames = parser['parse_xcursor'](data)
    assert frames, canonical
    size = max(frame['nominal'] for frame in frames)
    frames = [frame for frame in frames if frame['nominal'] == size]
    first = frames[0]
    assert all((f['width'], f['height'], f['hot_x'], f['hot_y']) ==
               (first['width'], first['height'], first['hot_x'], first['hot_y']) for f in frames)
    dest = work / 'hyprcursors' / canonical
    dest.mkdir(parents=True, exist_ok=True)
    meta = ['resize_algorithm = none',
            f"hotspot_x = {first['hot_x'] / first['width']:.12f}",
            f"hotspot_y = {first['hot_y'] / first['height']:.12f}"]
    meta += ['define_override = ' + name for name in names if name != canonical]
    for i, frame in enumerate(frames):
        width, height = frame['width'], frame['height']
        raw = bytearray()
        for y in range(height):
            raw.append(0)
            for x in range(width):
                pixel = struct.unpack_from('<I', data, frame['pixel_offset'] + (y * width + x) * 4)[0]
                a = pixel >> 24
                rgb = [(pixel >> shift) & 255 for shift in (16, 8, 0)]
                if 0 < a < 255:
                    rgb = [min(255, (c * 255 + a // 2) // a) for c in rgb]
                raw.extend((*rgb, a))
        png = b'\x89PNG\r\n\x1a\n'
        png += parser['png_chunk'](b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 6, 0, 0, 0))
        png += parser['png_chunk'](b'IDAT', zlib.compress(raw))
        png += parser['png_chunk'](b'IEND', b'')
        filename = f'frame-{i:03d}.png'
        (dest / filename).write_bytes(png)
        meta.append(f"define_size = {size}, {filename}, {frame['delay']}")
        for render_size in RENDER_SIZES:
            if render_size == size:
                continue
            scaled_name = f'frame-{render_size}-{i:03d}.png'
            render_frame(data, frame, render_size, dest / scaled_name)
            meta.append(f"define_size = {render_size}, {scaled_name}, {frame['delay']}")
    (dest / 'meta.hl').write_text('\n'.join(meta) + '\n')
    (theme / 'cursors' / canonical).write_bytes(data)
    for name in names:
        if name != canonical:
            (theme / 'cursors' / name).symlink_to(canonical)
    report.append({'shape': canonical, 'aliases': names, 'size': size,
                   'width': first['width'], 'height': first['height'],
                   'hotspot': [first['hot_x'], first['hot_y']],
                   'render_sizes': list(RENDER_SIZES),
                   'frames': len(frames), 'duration_ms': sum(f['delay'] for f in frames)})
subprocess.run(['hyprcursor-util', '--create', str(work), '-o', str(output)], check=True)
compiled = output / 'theme_Win11OSX'
shutil.copy2(compiled / 'manifest.hl', theme / 'manifest.hl')
shutil.copytree(compiled / 'hyprcursors', theme / 'hyprcursors')
shutil.copy2(source.parent / 'ReadMe.txt', theme / 'LICENSE.txt')
(theme / 'SOURCE.md').write_text('''# Win11OSX 1.1

Original artwork by MOYASH: https://www.gnome-look.org/p/2334253
Author: https://www.gnome-look.org/u/moyash
Archive: Win11OSX.zip (file ID 1766254436)
SHA256: d46a4f5e557ae8d3b9b65670d4913836a81932dff45d359460d19913cb483292

The archive's ReadMe is preserved as LICENSE.txt (CC BY-NC-ND).
The website lists CC BY-SA, but Strata follows the archive's stricter terms.
The XCursor artwork is unchanged. Identical aliases use relative symlinks.
Hyprcursor packaging uses the original 96px frames, animation delays and
click points, with format conversion only. This is raster artwork, not SVG.
Discrete sizes from 24 to 96px are pre-rendered with Cairo. Resizing is disabled
in Hyprcursor metadata to bypass its PNG downscaling clip bug. Other requested
sizes select the nearest complete frame. Original XCursor files are unchanged.
Rebuild with bin/strata-build-win11osx-cursor EXTRACTED_THEME OUTPUT_DIRECTORY.
''')
(theme / 'conversion.json').write_text(json.dumps(report, indent=2) + '\n')
print(f'Packaged {len(report)} cursor shapes and {sum(len(r["aliases"]) for r in report)} names.')
