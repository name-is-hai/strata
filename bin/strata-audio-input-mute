#!/bin/bash

# strata:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  strata-brightness-keyboard-mute on
  strata-osd -i microphone-muted -m "Microphone muted"
else
  strata-brightness-keyboard-mute off
  strata-osd -i microphone -m "Microphone on"
fi
