#!/usr/bin/env bash

# strata:summary=Copy text to the clipboard and type or paste it
# strata:group=clipboard
# strata:args=[--paste|--shift-insert] [--copy-only] [--stdin|--history-index <index>|<text>]
# strata:examples=strata clipboard paste text "hello" | strata clipboard paste text --shift-insert "hello"
# strata:hidden=true

set -o pipefail

from_stdin=false
use_shift_insert=false
use_paste=false
copy_only=false
history_index=""
text=""

while (( $# > 0 )); do
  case "$1" in
    --paste)
      use_paste=true
      shift
      ;;
    --stdin)
      from_stdin=true
      shift
      ;;
    --shift-insert)
      use_shift_insert=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    --history-index)
      history_index="${2:-}"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

copy_history_entry() {
  local history_path="$HOME/.local/state/strata/clipboard-history.json"

  [[ $history_index =~ ^[0-9]+$ ]] || exit
  jq -ej --argjson index "$history_index" '
    .[$index] | if .type == "text" and (.text | type == "string")
    then .text else error("Invalid clipboard entry") end
  ' "$history_path" | wl-copy
}

if [[ $from_stdin == "true" ]]; then
  # Stream the exact selection, including trailing newlines and large entries.
  # A failed copy must not paste the previous clipboard contents.
  wl-copy || exit 1
  [[ $use_shift_insert == "true" ]] || use_paste=true
elif [[ -n $history_index ]]; then
  copy_history_entry || exit 1
  if [[ $copy_only != "true" ]]; then
    [[ $use_shift_insert == "true" ]] || use_paste=true
  fi
else
  text=${1:-}
  [[ -n $text ]] || exit
  printf '%s' "$text" | wl-copy || exit 1
fi

if [[ $copy_only == "true" ]]; then
  exit
fi

sleep 0.15

if [[ $use_paste == "true" ]]; then
  exec "$(dirname -- "$(readlink -f -- "$0")")/strata-clipboard-send-paste"
elif [[ $use_shift_insert == "true" ]]; then
  wtype -M shift -k Insert -m shift 2>/dev/null || true
else
  wtype "$text" 2>/dev/null || true
fi
