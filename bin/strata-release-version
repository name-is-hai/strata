#!/usr/bin/env bash
# strata:summary=Set the GitHub release version and release notes
set -euo pipefail
repo_root=$("$(dirname -- "${BASH_SOURCE[0]}")/strata-cmd-repo-root")
cd "$repo_root"
check=false
version=
messages=()
usage() { echo 'Usage: strata-release-version [VERSION] [-m MESSAGE]... | --check'; }
while (( $# )); do
  case "$1" in
    -m)
      (( $# >= 2 )) && [[ -n ${2//[[:space:]]/} && $2 != *$'\n'* && $2 != *$'\r'* ]] || {
        echo '-m requires a nonempty, single-line changelog message' >&2; exit 64;
      }
      messages+=("$2"); shift 2 ;;
    --check) check=true; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 64 ;;
    *) [[ -z $version ]] || { usage >&2; exit 64; }; version=$1; shift ;;
  esac
done
if $check && { [[ -n $version ]] || (( ${#messages[@]} )); }; then usage >&2; exit 64; fi
version=${version:-$(<VERSION)}
[[ $version =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || {
  echo "Invalid release version: $version" >&2; exit 64;
}
# The runtime identifies the config package, independently of the release tag.
config_version=$(awk '/^Version:/ {print $2; exit}' packaging/strata-config.spec)
[[ $config_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $(<runtime-version) == "$config_version" ]] || {
  echo "runtime-version must match strata-config.spec ($config_version), not the release tag." >&2
  echo 'Use strata-package-version config VERSION to update the config package.' >&2
  exit 1
}
notes_title=$(head -n 1 .github/release-notes.md 2>/dev/null || true)
if $check; then
  [[ $notes_title == "# Strata $version" ]] || {
    echo 'Release notes do not match VERSION. Run bin/strata-release-version -m "Release message".' >&2; exit 1;
  }
  exit 0
fi
if (( ${#messages[@]} )) || [[ $notes_title != "# Strata $version" ]]; then
  mkdir -p .github
  {
    printf '# Strata %s\n\n' "$version"
    if (( ${#messages[@]} )); then printf -- '- %s\n' "${messages[@]}"
    else printf -- '- Publish Strata %s.\n' "$version"; fi
  } > .github/release-notes.md
fi
printf '%s\n' "$version" > VERSION
printf 'Strata release version: %s (RPM versions unchanged)\n' "$version"
