#!/usr/bin/env python3
# strata:summary=Start a private RDP backend only while a client is connected
# strata:hidden=true
"""Forward encrypted RDP bytes unchanged; the backend still owns TLS/auth."""
import os
import signal
import socket
import subprocess
import sys
import threading
import time


def stop_backend(process):
    if process.poll() is None:
        process.terminate()
    try:
        process.wait(timeout=25)
    except subprocess.TimeoutExpired:
        # The session supervisor normally restores displays and removes its
        # output. Preserve its recovery journal if a stuck backend needs killing.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def forward(client, command, stopping):
    process = None
    upstream = None
    try:
        # Select an ephemeral loopback port; the backend never listens publicly.
        with socket.socket() as reservation:
            reservation.bind(('127.0.0.1', 0))
            port = reservation.getsockname()[1]
        process = subprocess.Popen(command + [f'127.0.0.1:{port}'], start_new_session=True)
        deadline = time.monotonic() + 45
        while not stopping.is_set() and process.poll() is None and time.monotonic() < deadline:
            try:
                upstream = socket.create_connection(('127.0.0.1', port), timeout=0.2)
                upstream.settimeout(None)
                break
            except OSError:
                stopping.wait(0.05)
        if upstream is None:
            return
        finished = threading.Event()

        def copy(source, destination):
            try:
                while data := source.recv(65536):
                    destination.sendall(data)
            except OSError:
                pass
            finally:
                finished.set()

        readers = [threading.Thread(target=copy, args=pair, daemon=True)
                   for pair in ((client, upstream), (upstream, client))]
        for reader in readers:
            reader.start()
        while not finished.wait(0.1) and not stopping.is_set():
            if process.poll() is not None:
                break
    finally:
        for connection in (client, upstream):
            if connection is not None:
                try:
                    connection.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
                connection.close()
        if process is not None:
            stop_backend(process)
        for reader in locals().get('readers', []):
            reader.join(timeout=1)


def listen(command, address=None):
    stopping = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: stopping.set())
    if address is None:
        try:
            listener = socket.create_server(('::', 3389), family=socket.AF_INET6, dualstack_ipv6=True)
        except OSError:
            listener = socket.create_server(('0.0.0.0', 3389))
    else:
        listener = socket.create_server(address)
    worker = None
    with listener:
        print(f'RDP listener ready on {listener.getsockname()}; virtual display starts on connection.', flush=True)
        listener.settimeout(0.5)
        while not stopping.is_set():
            try:
                client, _ = listener.accept()
            except socket.timeout:
                continue
            # No queued second session can race the first one's restoration.
            if worker is not None and worker.is_alive():
                client.close()
                continue
            worker = threading.Thread(target=forward, args=(client, command, stopping))
            worker.start()
        if worker is not None:
            worker.join()


if __name__ == '__main__':
    if len(sys.argv) < 2:
        sys.exit('Usage: strata-remote-desktop-listener COMMAND [ARGUMENTS...]')
    listen(sys.argv[1:])
