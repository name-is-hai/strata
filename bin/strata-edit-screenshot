#!/usr/bin/env bash
# strata:summary=Open a saved screenshot in the annotation editor

# Open a saved screenshot in Strata Snip's annotation overlay. Notifications
# call this stable Strata command on installed and development machines.
set -euo pipefail

if (($# != 1)) || [[ $1 != /* || ! -f $1 || -L $1 ]]; then
  echo "Usage: strata-edit-screenshot <saved-image>" >&2
  exit 2
fi

snip_bin="${STRATA_SNIP_BIN:-/usr/share/strata/bin/strata-snip}"
if [[ -z ${STRATA_SNIP_BIN:-} && ! -x $snip_bin ]] && command -v strata-snip >/dev/null 2>&1; then
  snip_bin=$(command -v strata-snip)
fi
if [[ ! -x $snip_bin ]]; then
  echo "strata-edit-screenshot: Strata Snip is not installed" >&2
  exit 1
fi

exec "$snip_bin" --file "$1" --editor overlay
