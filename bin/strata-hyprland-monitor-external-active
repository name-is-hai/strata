#!/usr/bin/env bash

# strata:summary=Returns true when Hyprland has an active external monitor
# strata:hidden=true

hyprctl monitors all -j | jq -e 'any(.[]; .name != "FALLBACK" and
  (.name | test("^(eDP|LVDS|DSI)-") | not) and .disabled != true and
  (.width // 0) > 0 and (.height // 0) > 0)' >/dev/null 2>&1
