#!/usr/bin/env bash

# strata:summary=Control night light and report its effective state
# strata:args=[on|off|toggle|--status|--temperature K]
# strata:examples=strata toggle nightlight

set -euo pipefail

ON_TEMP=4000
IDENTITY_TEMP=6000

current_identity() {
  local value
  value=$(hyprctl hyprsunset identity get 2>/dev/null) || return 1
  [[ $value == true || $value == false ]] || return 1
  printf '%s\n' "$value"
}

current_temp() {
  local value
  value=$(hyprctl hyprsunset temperature 2>/dev/null) || return 1
  [[ $value =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$value"
}

is_enabled() {
  local identity temp
  identity=$(current_identity) || return 1
  temp=$(current_temp) || return 1
  [[ $identity == false ]] && (( temp < IDENTITY_TEMP ))
}

status_json() {
  local identity temp enabled=false
  identity=$(current_identity) || identity=true
  temp=$(current_temp) || temp=""
  if [[ $identity == false && -n $temp ]] && (( temp < IDENTITY_TEMP )); then
    enabled=true
  fi
  jq -cn --argjson enabled "$enabled" --argjson identity "$identity" --arg temp "$temp" \
    '{enabled:$enabled, identity:$identity, temperature:(($temp | tonumber?) // null)}'
}

ensure_running() {
  current_identity >/dev/null && return 0
  systemctl --user start hyprsunset.service || return 1
  local attempt
  for attempt in {1..30}; do
    current_identity >/dev/null && return 0
    sleep 0.1
  done
  echo "Night light did not start" >&2
  return 1
}

turn_on() {
  local profile profile_temp
  profile=$(hyprctl hyprsunset profile 2>/dev/null) || profile=""
  profile_temp=$(sed -n 's/^Temperature: \([0-9][0-9]*\)$/\1/p' <<<"$profile")
  if [[ $profile == *"Identity: false"* && -n $profile_temp ]] && (( profile_temp < IDENTITY_TEMP )); then
    hyprctl hyprsunset reset >/dev/null
  else
    hyprctl hyprsunset gamma 100 >/dev/null
    hyprctl hyprsunset temperature "$ON_TEMP" >/dev/null
  fi
}

turn_off() {
  # Identity disables the temperature filter; restore gamma too, since the
  # scheduled night profile may dim it independently.
  hyprctl hyprsunset gamma 100 >/dev/null
  hyprctl hyprsunset identity >/dev/null
}

case ${1:-toggle} in
  --temperature)
    value=${2:-}
    [[ $value =~ ^[0-9]{4}$ ]] && (( value >= 1000 && value <= 6500 )) || {
      echo "Temperature must be an integer from 1000 to 6500 K." >&2
      exit 2
    }
    ensure_running
    hyprctl hyprsunset gamma 100 >/dev/null
    hyprctl hyprsunset temperature "$value" >/dev/null
    strata-shell -q nightlight refresh || true
    ;;
  --status)
    status_json
    exit 0
    ;;
  on|off|toggle)
    ensure_running
    if [[ ${1:-toggle} == on ]]; then
      turn_on
    elif [[ ${1:-toggle} == off ]]; then
      turn_off
    elif is_enabled; then
      turn_off
    else
      turn_on
    fi
    strata-shell -q nightlight refresh || true
    ;;
  *)
    echo "Usage: strata-toggle-nightlight [on|off|toggle|--status]" >&2
    exit 2
    ;;
esac
