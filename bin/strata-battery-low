#!/usr/bin/env bash

# strata:summary=Send the low battery warning notification and run battery-low hooks.
# strata:args=<percentage>
# strata:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: strata-battery-low <percentage>" >&2
  exit 1
fi

level=$1

strata-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
strata-hook battery-low "$level"
