#!/usr/bin/env bash

# strata:summary=Set the default editor used by strata-launch-editor
# strata:args=[code|cursor|zed|sublime_text|helix|vim|emacs|nvim]
# strata:examples=strata default editor | strata default editor code | strata default editor helix

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

editor_file="$HOME/.local/state/strata/defaults/editor"

if (($# == 0)); then
  if [[ -f $editor_file ]]; then
    read -r editor <"$editor_file"
  fi

  # sublime-text-4 ships `subl`; older defaults stored `sublime_text`.
  [[ $editor == sublime_text ]] && editor=subl

  [[ -n $editor ]] && echo "$editor" || echo "nvim"
  exit 0
fi

case "$1" in
code) selection="code"; editor="code"; name="VSCode"; glyph= ;;
cursor) selection="cursor"; editor="cursor"; name="Cursor"; glyph= ;;
zed | zeditor) selection="zed"; editor="zeditor"; name="Zed"; glyph= ;;
sublime_text | subl) selection="sublime_text"; editor="subl"; name="Sublime Text"; glyph= ;;
helix) selection="helix"; editor="helix"; name="Helix"; glyph= ;;
vim) selection="vim"; editor="vim"; name="Vim"; glyph= ;;
emacs) selection="emacs"; editor="emacs"; name="Emacs"; glyph= ;;
nvim) selection="nvim"; editor="nvim"; name="Neovim"; glyph= ;;
*)
  echo "Usage: strata-default-editor <code|cursor|zed|sublime_text|helix|vim|emacs|nvim>"
  exit 1
  ;;
esac

if strata-cmd-missing "$editor"; then
  if [[ $installing == "false" ]]; then
    exec strata-launch-floating-terminal-with-presentation strata-default-editor --install "$selection"
  else
    case "$selection" in
    code) strata-install-editor-vscode ;;
    cursor) strata-pkg-add cursor-bin ;;
    zed) strata-install-editor-zed ;;
    sublime_text) strata-pkg-add sublime-text-4 ;;
    helix) strata-install-editor-helix ;;
    vim) strata-pkg-add vim ;;
    emacs) strata-install-editor-emacs ;;
    nvim) strata-pkg-add neovim ;;
    esac || exit 1
  fi
fi

mkdir -p "$(dirname "$editor_file")"
printf '%s\n' "$editor" >"$editor_file"

strata-notification-send -g $glyph "$name is now the default editor"
