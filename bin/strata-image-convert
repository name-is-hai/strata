#!/usr/bin/env python3
# strata:summary=Convert, resize and compress an image without replacing the original
# strata:args=[image] [--format jpg|png|webp] [--size original|high|medium|low] [--quality 1-100] [--output file] [--interactive]
import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def dialog(*args):
    result = subprocess.run(['zenity', *args], text=True, stdout=subprocess.PIPE)
    if result.returncode:
        raise InterruptedError
    return result.stdout.rstrip('\n')


def main():
    parser = argparse.ArgumentParser(description='Convert or resize a still image; the original is preserved. Animated inputs export their first frame.')
    parser.add_argument('image', nargs='?')
    parser.add_argument('--format', choices=['jpg', 'png', 'webp'])
    parser.add_argument('--size', choices=['original', 'high', 'medium', 'low'])
    parser.add_argument('--quality', type=int, default=85)
    parser.add_argument('--output', type=Path)
    parser.add_argument('--interactive', action='store_true')
    args = parser.parse_args()
    if not 1 <= args.quality <= 100:
        parser.error('--quality must be between 1 and 100')
    interactive = args.interactive or args.image is None
    try:
        source = Path(args.image or dialog('--file-selection', '--title=Choose an image')).resolve(strict=True)
        if not source.is_file():
            raise ValueError('Choose an image file')
        fmt = args.format
        size = args.size
        if interactive:
            if not fmt:
                fmt = dialog('--list', '--title=Image format', '--text=Export a still image. Animated inputs use their first frame.', '--column=Format', 'webp', 'jpg', 'png')
            if not size:
                size = dialog('--list', '--title=Image size', '--text=Maximum width: high 3160 px, medium 2160 px, low 1080 px. Smaller images are never enlarged.', '--column=Size', 'original', 'high', 'medium', 'low')
        fmt, size = fmt or 'webp', size or 'medium'
        if fmt not in ('jpg', 'png', 'webp') or size not in ('original', 'high', 'medium', 'low'):
            raise ValueError('Invalid format or size')
        output = args.output or source.with_name(f'{source.stem}-{size}.{fmt}')
        output = output.absolute()
        if output.suffix.lower() not in (('.jpg', '.jpeg') if fmt == 'jpg' else ('.' + fmt,)):
            raise ValueError('Output extension must match the selected format')
        if args.output and output.exists():
            raise FileExistsError(f'Output already exists: {output}')
        if not args.output:
            number = 2
            while output.exists():
                output = source.with_name(f'{source.stem}-{size}-{number}.{fmt}')
                number += 1
        fd, temporary = tempfile.mkstemp(prefix='.strata-image-', suffix='.' + fmt, dir=output.parent)
        os.close(fd)
        try:
            command = ['magick', str(source) + '[0]', '-auto-orient']
            if size != 'original':
                command += ['-resize', {'high': '3160x>', 'medium': '2160x>', 'low': '1080x>'}[size]]
            if fmt == 'jpg':
                command += ['-background', 'white', '-alpha', 'remove', '-alpha', 'off']
            command += ['-strip', '-quality', str(args.quality)]
            if fmt == 'png':
                command += ['-define', 'png:compression-level=9']
            subprocess.run(command + [temporary], check=True, timeout=120)
            # Publish atomically without overwriting a file created meanwhile.
            os.link(temporary, output)
        finally:
            Path(temporary).unlink(missing_ok=True)
        print(output)
        if interactive:
            dialog('--info', '--title=Image saved', '--no-markup', '--text=' + str(output))
        return 0
    except InterruptedError:
        return 0
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'strata-image-convert: {error}', file=sys.stderr)
        if interactive:
            subprocess.run(['zenity', '--error', '--no-markup', '--text=' + str(error)])
        return 1


if __name__ == '__main__':
    sys.exit(main())
