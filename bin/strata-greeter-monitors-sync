#!/usr/bin/env bash
# strata:summary=Synchronize display enable states and scales to the greeter
# strata:hidden=true
# Publish validated display data, never execute personal Lua as root.
set -euo pipefail
[[ $# == 0 || ( $# == 1 && $1 == --print ) ]] || exit 64
errors=$(hyprctl configerrors)
[[ -z ${errors//[[:space:]]/} ]] || exit 0
rows=$(hyprctl monitors all -j | jq -ce '
  if type == "array" and length > 0 and
     any(.[]; .disabled != true and .width > 0 and .height > 0)
  then map({name, disabled:(.disabled == true)} +
    (if .disabled == true then {} else
      {scale:(if ((.scale // 0) > 0) then .scale else 1 end)} end))
  else error("No usable display state") end')
# Closing the lid temporarily removes an enabled panel from the desktop; that
# is not a permanent preference for the next login screen.
clamshell=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/strata-monitor-clamshell.json
if [[ -f $clamshell ]]; then
  name=$(jq -r 'select(.disabled == false) | .name // empty' "$clamshell")
  if [[ $name =~ ^(eDP|LVDS|DSI)-[A-Za-z0-9._-]+$ ]]; then
    rows=$(jq -c --slurpfile original "$clamshell" --arg name "$name" \
      'map(if .name == $name then .disabled = false | .scale = $original[0].scale else . end)' <<<"$rows")
  fi
fi
# An emergency laptop fallback is temporary; publish its original disabled
# preference, not the recovered runtime state, to the next login screen.
fallback=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/strata-monitor-fallback.json
if [[ -f $fallback ]]; then
  name=$(jq -r 'select(.disabled == true) | .name // empty' "$fallback")
  if [[ $name =~ ^(eDP|LVDS|DSI)-[A-Za-z0-9._-]+$ ]]; then
    rows=$(jq -c --arg name "$name" 'map(if .name == $name then .disabled = true else . end)' <<<"$rows")
    # With only the temporary panel connected, retain the existing policy.
    jq -e 'any(.[]; .disabled == false)' <<<"$rows" >/dev/null || exit 0
  fi
fi
if [[ ${1:-} == --print ]]; then
  printf '%s\n' "$rows"
else
  pkexec /usr/share/strata/bin/strata-greeter-monitors-install "$rows"
fi
