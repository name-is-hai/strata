#!/usr/bin/env bash
set -euo pipefail

output=${1:-}
if [[ $EUID -ne 0 ]]; then
  echo 'Run this helper through pkexec' >&2
  exit 77
fi
if [[ ! $output =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo 'Expected a monitor connector name' >&2
  exit 64
fi

destination=/etc/strata/main-monitor
install -d -m 0755 /etc/strata
temporary=$(mktemp /etc/strata/.main-monitor.XXXXXX)
trap 'rm -f -- "$temporary"' EXIT
printf '%s\n' "$output" > "$temporary"
chown root:root "$temporary"
chmod 0644 "$temporary"
mv -f -- "$temporary" "$destination"
