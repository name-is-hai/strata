#!/usr/bin/env bash
# strata:hidden=true
# strata:summary=Configure the RDP port on the active firewalld zones
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mode=${1:-check}
[[ $mode == check || $mode == open ]] || { echo 'Usage: strata-remote-desktop-firewall {check|open}' >&2; exit 64; }
if [[ $mode == open && $EUID != 0 ]]; then echo 'Administrator authorization is required.' >&2; exit 1; fi
# An inactive firewall needs no opening; do not enable or reconfigure it.
firewall-cmd --state >/dev/null 2>&1 || exit 0
default_zone=$(firewall-cmd --get-default-zone)
active_zones=$(firewall-cmd --get-active-zones)
mapfile -t zones < <(printf '%s\n%s\n' "$default_zone" "$active_zones" | awk '/^[^[:space:]]/ {print $1}' | sort -u)
(( ${#zones[@]} )) || exit 1
for zone in "${zones[@]}"; do
  for scope in runtime permanent; do
    options=(--quiet "--zone=$zone")
    [[ $scope != permanent ]] || options+=(--permanent)
    if ! firewall-cmd "${options[@]}" --query-service=rdp; then
      [[ $mode == open ]] || exit 1
      firewall-cmd "${options[@]}" --add-service=rdp
    fi
  done
done
