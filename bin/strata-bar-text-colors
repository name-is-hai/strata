#!/usr/bin/env python3
# strata:summary=Sample local foreground colors along each display's bar
# strata:hidden=true
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def luminance(rgb):
    linear = [v / 12.92 if v <= .04045 else ((v + .055) / 1.055) ** 2.4 for v in rgb]
    return sum(a * b for a, b in zip(linear, (.2126, .7152, .0722)))


def color_at(rgb, preferred, alternate):
    level = luminance([v / 255 for v in rgb])
    def contrast(color):
        value = luminance([int(color[i:i+2], 16) / 255 for i in (1, 3, 5)])
        return (max(value, level) + .05) / (min(value, level) + .05)
    if contrast(preferred) >= 4.5:
        return preferred
    return max((preferred, alternate, '#000000', '#ffffff'), key=contrast)


def sample(path, monitor, edge, thickness, preferred, alternate):
    width, height = int(monitor['width']), int(monitor['height'])
    if int(monitor.get('transform', 0)) % 2:
        width, height = height, width
    if not (0 < width <= 32768 and 0 < height <= 32768):
        raise ValueError('Invalid display size')
    horizontal = edge in ('top', 'bottom')
    size = min(height if horizontal else width, max(1, round(thickness * float(monitor.get('scale', 1)))))
    crop = {'top': f'{width}x{size}+0+0', 'bottom': f'{width}x{size}+0+{height-size}',
            'left': f'{size}x{height}+0+0', 'right': f'{size}x{height}+{width-size}+0'}[edge]
    result = subprocess.run(['magick', str(path) + '[0]', '-auto-orient',
        '-resize', f'{width}x{height}^', '-gravity', 'center', '-extent', f'{width}x{height}',
        '-gravity', 'NorthWest', '-crop', crop, '+repage', '-resize', '256x1!' if horizontal else '1x256!',
        '-colorspace', 'sRGB', '-depth', '8', 'rgb:-'], stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, check=True, timeout=20).stdout
    if len(result) != 256 * 3:
        raise ValueError('Unexpected sample size')
    return [color_at(result[i:i+3], preferred, alternate) for i in range(0, len(result), 3)]


def main():
    edge, thickness, preferred, alternate = sys.argv[1:5]
    if edge not in ('top', 'bottom', 'left', 'right') or not all(re.fullmatch(r'#[0-9a-fA-F]{6}', c) for c in (preferred, alternate)):
        raise ValueError('Invalid arguments')
    thickness = max(1, min(512, int(thickness)))
    path = (Path(os.environ['HOME']) / '.local/state/strata/current/background').resolve(strict=True)
    monitors = json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j'], timeout=5))
    samples = {}
    for monitor in monitors:
        if monitor.get('disabled') or monitor.get('name') == 'FALLBACK':
            continue
        try:
            samples[monitor['name']] = sample(path, monitor, edge, thickness, preferred, alternate)
        except (ValueError, KeyError, subprocess.SubprocessError, OSError):
            continue
    print(json.dumps({'samples': samples}, separators=(',', ':')))


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, subprocess.SubprocessError, OSError):
        print('{"samples":{}}')
