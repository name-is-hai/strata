#!/bin/bash

# strata:summary=Launch a TUI command in the default terminal with Strata styling
# strata:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.strata.$(basename $1)"
fi

exec setsid uwsm-app -- ghostty --class="$APP_ID" -e "$1" "${@:2}"
