#!/usr/bin/env bash

# strata:summary=Open a clipboard history entry
# strata:group=clipboard
# strata:args=--history-index <index>
# strata:hidden=true

history_index=""
history_path="$HOME/.local/state/strata/clipboard-history.json"

while (( $# > 0 )); do
  case "$1" in
    --history-index)
      history_index="${2:-}"
      shift 2
      ;;
    *)
      echo "Usage: strata-clipboard-open --history-index <index>" >&2
      exit 1
      ;;
  esac
done

[[ $history_index =~ ^[0-9]+$ ]] || exit 1
[[ -r $history_path ]] || exit 1

entry_type=$(jq -er --argjson index "$history_index" '.[$index].type' "$history_path") || exit 1

open_image() {
  local path="$1"

  [[ -r $path ]] || exit 1
  exec xdg-open "$path"
}

open_files_from_text() {
  local candidate file
  local -a files=()
  while IFS= read -r candidate || [[ -n $candidate ]]; do
    candidate=${candidate%$'\r'}
    [[ -n $candidate ]] || continue
    case "$candidate" in
      file://localhost/*) candidate="file:///${candidate#file://localhost/}" ;;
    esac
    case "$candidate" in
      file:///*)
        [[ ${candidate,,} != *%00* ]] || return 1
        file=$(perl -e '$s = shift; $s =~ s/%([0-9a-fA-F]{2})/chr(hex($1))/eg; print $s' "${candidate#file://}") || return 1
        ;;
      '~/'*) file="$HOME/${candidate#\~/}" ;;
      /*) file="$candidate" ;;
      *) return 1 ;;
    esac
    [[ -e $file ]] || return 1
    files+=("$file")
  done <<<"$1"

  (( ${#files[@]} > 0 )) || return 1
  if (( ${#files[@]} == 1 )); then
    exec xdg-open "${files[0]}"
  fi
  for file in "${files[@]}"; do
    xdg-open "$file" &
  done
  wait
  exit
}

open_text() {
  local text="$1"
  local url=""
  local open_dir=""
  local open_file=""

  open_files_from_text "$text"

  # A link alone opens the browser; a paragraph containing links stays text.
  if [[ $text =~ ^https?://[^[:space:]]+$ ]]; then
    url="$text"
  fi
  if [[ -z $url && $text =~ ^[[:space:]]*([[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,})(/[^[:space:]]*)?[[:space:]]*$ ]]; then
    url="https://${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
  fi

  if [[ -n $url ]]; then
    exec strata-launch-browser "$url"
  fi

  open_dir="${XDG_STATE_HOME:-$HOME/.local/state}/strata/clipboard-open"
  mkdir -p "$open_dir"
  open_file=$(mktemp --tmpdir="$open_dir" clipboard.XXXXXX.txt) || exit 1
  jq -j --argjson index "$history_index" '.[$index].text' "$history_path" >"$open_file"
  exec strata-launch-editor "$open_file"
}

case "$entry_type" in
  image)
    path=$(jq -er --argjson index "$history_index" '.[$index].path' "$history_path") || exit 1
    open_image "$path"
    ;;
  text)
    text=$(jq -er --argjson index "$history_index" '.[$index].text' "$history_path") || exit 1
    open_text "$text"
    ;;
  *)
    exit 1
    ;;
esac
