#!/usr/bin/env bash

# strata:summary=Pick one option from a menu
# strata:group=menu
# strata:name=select
# strata:args=prompt [option...] [-- menu args...]
# strata:examples=strata menu select Format jpg png|strata-menu-select Resolution 4k 1080p 720p -- --width 400

# An option may lead with an icon, as "<glyph><TAB><label>", and may trail a
# subtext shown under the label, as "<glyph><TAB><label><TAB><subtext>". The
# menu shows the glyph but never returns it. A plain option returns the label
# alone; an option with a subtext returns "<label><TAB><subtext>", so callers
# with same-named rows get the subtext back as the stable key.

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: strata-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
menu_width=""
menu_maxheight=""
menu_description=""

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    shift
    while (( $# > 0 )); do
      case "$1" in
        --description)
          shift
          if (( $# == 0 )); then
            echo "strata-menu-select: --description requires text" >&2
            exit 1
          fi
          menu_description="$1"
          ;;
        --width)
          shift
          if (( $# == 0 )); then
            echo "strata-menu-select: --width requires a value" >&2
            exit 1
          fi
          menu_width="$1"
          ;;
        --height|--maxheight)
          arg="$1"
          shift
          if (( $# == 0 )); then
            echo "strata-menu-select: $arg requires a value" >&2
            exit 1
          fi
          menu_maxheight="$1"
          ;;
      esac
      shift
    done
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

if (( ${#options[@]} == 0 )); then
  echo "Usage: strata-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

# jq is already a Strata runtime dependency. Keep this helper independent of
# Perl's optional JSON::PP module so every menu picker works on a minimal
# Fedora install too. Shell arguments cannot contain NUL, which makes it a
# safe delimiter while preserving spaces, tabs, and UTF-8 glyphs in rows.
options_json=$(printf '%s\0' "${options[@]}" | jq -Rs 'split("\u0000") | .[:-1]')
payload=$(jq -cn \
  --arg prompt "$prompt" \
  --argjson options "$options_json" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  --arg width "$menu_width" \
  --arg maxHeight "$menu_maxheight" \
  --arg description "$menu_description" \
  '{ mode: "select", prompt: $prompt, options: $options,
     description: $description,
     selectionFile: $selectionFile, doneFile: $doneFile }
   + (if $width == "" then {} else { width: ($width | tonumber) } end)
   + (if $maxHeight == "" then {} else { maxHeight: ($maxHeight | tonumber) } end)')

strata-shell shell summon strata.menu "$payload" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
