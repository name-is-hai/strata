#!/usr/bin/env python3
"""Read or set Fcitx5's global input-method toggle shortcut."""
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "fcitx5" / "config"
section = "[Hotkey/TriggerKeys]"
# Fcitx accepts named keys (F1, Escape, Page_Up, …), normal characters,
# and optional modifier prefixes. The UI records only this safe token set.
valid = re.compile(r"(?:(?:Control|Alt|Shift|Super)\+)*(?:space|[A-Za-z0-9_]+)$")

def read_text():
    if config.exists() and not config.is_file():
        raise ValueError("Fcitx5 config is not a regular file")
    return config.read_text() if config.exists() else ""

def current(text):
    # Only a real section header starts at the beginning of a line. Fcitx's
    # generated comments include text such as "# [Hotkey/ActivateKeys]".
    match = re.search(r"(?ms)^\[Hotkey/TriggerKeys\][^\n]*\n(.*?)(?=^\[[^\n]+\]|\Z)", text)
    if not match:
        return ""
    key = re.search(r"^0=(.+)$", match.group(1), re.M)
    return key.group(1).strip() if key else ""

def set_key(text, key):
    block = section + "\n0=" + key + "\n"
    pattern = re.compile(r"^\[Hotkey/TriggerKeys\]\n.*?(?=^\[|\Z)", re.M | re.S)
    if pattern.search(text):
        return pattern.sub(block, text, count=1)
    return text.rstrip() + "\n\n" + block

def write_atomic(text):
    config.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".strata-fcitx-", dir=config.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, config)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    text = read_text()
    if action == "get":
        print(current(text))
        return
    if action != "set" or len(sys.argv) != 3 or not valid.fullmatch(sys.argv[2]):
        raise ValueError("Usage: strata-fcitx-hotkey get | set <shortcut>")
    write_atomic(set_key(text, sys.argv[2]))
    subprocess.run(["fcitx5-remote", "-r"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(sys.argv[2])

try:
    main()
except Exception as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
