#!/usr/bin/env bash
# strata:summary=Install missing Strata user configuration files
set -euo pipefail

strata_root=/usr/share/strata
source_root=$strata_root/user-config
home_source=$strata_root/user-home
shell_source=$strata_root/shell
force=0
dry_run=0

for argument in "$@"; do
    case $argument in
        --force) force=1 ;;
        --dry-run) dry_run=1 ;;
        *)
            echo "Usage: strata-apply-config [--force] [--dry-run]" >&2
            exit 2
            ;;
    esac
done

if [[ ! -d $source_root ]]; then
    echo "Strata configuration is not installed at $source_root" >&2
    exit 1
fi

timestamp=$(date +%Y%m%d-%H%M%S)
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}

run() {
    if (( dry_run )); then
        printf 'Would run:'
        printf ' %q' "$@"
        printf '\n'
    else
        "$@"
    fi
}

while IFS= read -r -d '' source_file; do
    relative=${source_file#"$source_root"/}
    destination=$config_home/$relative
    run install -d "$(dirname "$destination")"

    if [[ -e $destination || -L $destination ]]; then
        if (( ! force )); then
            printf 'Keeping existing %s\n' "$destination"
            continue
        fi
        run cp -a -- "$destination" "$destination.backup-$timestamp"
    fi

    run install -m 0644 "$source_file" "$destination"
    (( dry_run )) || printf 'Installed %s\n' "$destination"
done < <(find "$source_root" -type f -print0 | sort -z)

if [[ -d $home_source ]]; then
    while IFS= read -r -d '' source_file; do
        relative=${source_file#"$home_source"/}
        destination=$HOME/$relative
        if [[ -e $destination || -L $destination ]]; then
            if (( ! force )); then
                printf 'Keeping existing %s\n' "$destination"
                continue
            fi
            run cp -a -- "$destination" "$destination.backup-$timestamp"
        fi
        run install -d "$(dirname "$destination")"
        run install -m 0644 "$source_file" "$destination"
        (( dry_run )) || printf 'Installed %s\n' "$destination"
    done < <(find "$home_source" -type f -print0 | sort -z)
fi

shell_destination=$config_home/quickshell/strata
legacy_shell=$config_home/quickshell/my-distro

# The former package owned this exact symlink. It contains no user data, so it
# is safe to retire when moving to the Strata namespace. A real directory or
# an unknown symlink is always left untouched.
if [[ ! -e $shell_destination && ! -L $shell_destination && -L $legacy_shell ]] && \
   [[ $(readlink -f -- "$legacy_shell") == /usr/share/quickshell/my-distro ]]; then
    run rm -- "$legacy_shell"
    (( dry_run )) || printf 'Migrated packaged shell link from %s\n' "$legacy_shell"
fi

run install -d "$(dirname "$shell_destination")"
if [[ -e $shell_destination || -L $shell_destination ]]; then
    if (( force )); then
        run cp -a -- "$shell_destination" "$shell_destination.backup-$timestamp"
        run rm -rf -- "$shell_destination"
    elif [[ $(readlink -f -- "$shell_destination") != "$shell_source" ]]; then
        printf 'Keeping existing %s\n' "$shell_destination"
        shell_destination=
    fi
fi

if [[ -n $shell_destination && ! -e $shell_destination && ! -L $shell_destination ]]; then
    run ln -s "$shell_source" "$shell_destination"
    (( dry_run )) || printf 'Linked %s\n' "$shell_destination"
fi

# Seed the desktop before its first login. Updating defaults must never reset
# an existing theme or wallpaper, including when --force refreshes config files.
current=$HOME/.local/state/strata/current
if [[ ! -e $current/theme && ! -L $current/theme && ! -e $current/theme.name &&
      ! -e $current/background && ! -L $current/background ]]; then
    default_theme=$(jq -er '.theme | select(type == "string" and test("^[a-zA-Z0-9_-]+$"))' "$strata_root/default/theme.json")
    default_background=$(jq -er '.background | select(type == "string" and length > 0 and . != "." and . != ".." and (contains("/") | not))' "$strata_root/default/theme.json")
    wallpaper=$strata_root/themes/$default_theme/backgrounds/$default_background
    [[ -f $wallpaper ]] || { echo "Default wallpaper is missing: $wallpaper" >&2; exit 1; }
    run env STRATA_PATH="$strata_root" PATH="$strata_root/bin:$PATH" STRATA_THEME_HEADLESS=1 \
        "$strata_root/bin/strata-theme-set" "$default_theme"
    run ln -nsf "$wallpaper" "$current/background"
fi

echo "Strata configuration is ready."
echo "If you are upgrading from My Distro, add STRATA_PATH and PATH from"
echo "$source_root/uwsm/env to your existing ~/.config/uwsm/env, then log out and back in."
