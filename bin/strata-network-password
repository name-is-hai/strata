#!/usr/bin/env bash

# strata:summary=Print the active Wi-Fi connection's password
# strata:group=network
# strata:args=<interface>

set -euo pipefail

# Reading a saved passphrase is deliberately a privileged action. The QR
# panel invokes this helper without a terminal, so pkexec routes the password
# prompt to Strata's Polkit agent instead of silently exposing the secret.
# Always elevate the installed copy: a checkout under a user's control must
# never be executed as root.
PACKAGED_PATH=/usr/share/strata/bin/strata-network-password
if (( EUID != 0 )); then
  [[ -x $PACKAGED_PATH ]] || {
    echo "Installed Strata password helper not found" >&2
    exit 1
  }
  exec pkexec "$PACKAGED_PATH" --authorized "$@"
fi

[[ ${1:-} == "--authorized" ]] || {
  echo "This helper must be run through Polkit" >&2
  exit 1
}
shift

# Never allow an arbitrary option to be passed to nmcli once this process has
# crossed the privilege boundary.
interface=${1:?Usage: strata-network-password <interface>}
[[ $interface =~ ^[[:alnum:]_.:-]+$ ]] || {
  echo "Invalid network interface" >&2
  exit 1
}
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
uuid=$(nmcli --get-values GENERAL.CON-UUID device show "$interface" | head -n 1)
[[ -n $uuid && $uuid != "--" ]] || { echo "No active Wi-Fi connection" >&2; exit 1; }

mapfile -t fields < <(nmcli --show-secrets --escape no --get-values \
  802-11-wireless-security.key-mgmt,802-11-wireless-security.psk,802-11-wireless-security.wep-key0 \
  connection show uuid "$uuid")

key_management=${fields[0]:-}
password=${fields[1]:-}
wep_key=${fields[2]:-}

[[ $key_management != *eap* && $key_management != *ieee8021x* ]] || {
  echo "Enterprise Wi-Fi has no shareable password" >&2
  exit 1
}
if [[ -z $key_management || $key_management == "none" ]]; then
  # NetworkManager models WEP as key-mgmt "none" plus a wep-key.
  password=$wep_key
  [[ -n $password ]] || { echo "This network has no password" >&2; exit 1; }
fi
[[ -n $password ]] || { echo "Could not read the Wi-Fi password" >&2; exit 1; }

# Stdout is a private pipe to the caller; the secret is never an argument, so
# it never shows up in /proc cmdlines.
printf '%s\n' "$password"
