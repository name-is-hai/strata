#!/usr/bin/env bash
# strata:summary=Install the greeter wallpaper snapshot
# Install the active Strata wallpaper where the login greeter can read it.
# This helper deliberately runs through pkexec. greetd cannot read a user's
# private state directory, so it needs a system-owned copy of the wallpaper.
set -euo pipefail

source_path=${1:-}
destination=/usr/share/strata/greeter/background.jpg
source_hash_file=/usr/share/strata/greeter/background.sha256
output_hash_file=/usr/share/strata/greeter/background-output.sha256

if [[ -z $source_path ]]; then
  echo "Usage: strata-greeter-background-install <image-or-video>" >&2
  exit 64
fi

source_path=$(readlink -f -- "$source_path")
[[ -f $source_path ]] || { echo "Background does not exist: $source_path" >&2; exit 66; }

# A caller authenticated by polkit may only publish a wallpaper from their own
# home directory or from Strata's packaged backgrounds. This keeps the helper
# from being used to expose arbitrary root-readable files via the greeter.
caller_home=$(getent passwd "${PKEXEC_UID:-}" | cut -d: -f6)
case "$source_path" in
  "$caller_home"/*|/usr/share/strata/themes/*/backgrounds/*|/usr/share/backgrounds/*) ;;
  *)
    echo "Background must be in your home directory or a packaged Strata background" >&2
    exit 77
    ;;
esac

extension=${source_path##*.}
extension=${extension,,}
temporary=$(mktemp /tmp/strata-greeter-wallpaper.XXXXXX.jpg)
trap 'rm -f -- "$temporary"' EXIT
case "$extension" in
  jpg|jpeg|png|gif|bmp|webp)
    ffmpeg -nostdin -hide_banner -loglevel error -y -i "$source_path" \
      -vf 'gblur=sigma=18' -frames:v 1 -q:v 3 "$temporary"
    install -Dm644 -- "$temporary" "$destination"
    ;;
  mp4|m4v|mov|webm|mkv|avi)
    # Use one blurred video frame so login does not decode video on both GPUs.
    ffmpeg -nostdin -hide_banner -loglevel error -y -ss 00:00:01 -i "$source_path" \
      -vf 'gblur=sigma=18' -frames:v 1 -q:v 3 "$temporary"
    install -Dm644 -- "$temporary" "$destination"
    ;;
  *)
    echo "Unsupported background type: .$extension" >&2
    exit 65
    ;;
esac
sha256sum -- "$source_path" | cut -d' ' -f1 > "$source_hash_file"
sha256sum -- "$destination" | cut -d' ' -f1 > "$output_hash_file"
chmod 0644 "$source_hash_file" "$output_hash_file"
