#!/usr/bin/env bash

# strata:summary=Launch a TUI or focus an existing terminal window for it
# strata:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.strata.$(basename "$1")"
fi

LAUNCH_COMMAND="strata-launch-tui $@"

exec strata-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
