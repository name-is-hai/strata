#!/usr/bin/env bash

# strata:summary=Open the Strata background switcher
# strata:group=theme
# strata:name=bg-switcher
# strata:aliases=strata background

# Preserve the command's selection-only contract for scripts: the caller
# decides whether to apply the returned path.
exec "${STRATA_PATH:-/usr/share/strata}/shell/plugins/theme-picker/pick.sh" --background
