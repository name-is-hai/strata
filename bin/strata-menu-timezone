#!/usr/bin/env bash

# strata:summary=Select and set the system timezone
# strata:group=menu
# strata:name=timezone

set -e

timezone=$(timedatectl list-timezones | strata-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
strata-shell -q strata.clock refresh
strata-notification-send "Timezone is now set to $timezone"
