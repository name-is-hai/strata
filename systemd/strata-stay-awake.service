[Unit]
Description=Strata Stay Awake inhibitor

[Service]
Type=simple
# This is deliberately a sleep-only inhibitor: automatic suspend is blocked,
# while Hyprland and Quickshell are still free to lock an idle session.
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=Strata --why=Stay Awake /usr/bin/sleep infinity
