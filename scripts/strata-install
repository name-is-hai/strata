#!/usr/bin/env bash
set -euo pipefail

repo_url=${STRATA_REPO_URL:-https://name-is-hai.github.io/strata}
dotfiles_repo=${STRATA_DOTFILES_REPO:-https://github.com/name-is-hai/dotfiles.git}
enable_sddm=0
install_user=${STRATA_INSTALL_USER:-${SUDO_USER:-}}

for argument in "$@"; do
  case "$argument" in
    --enable-sddm) enable_sddm=1 ;;
    -h|--help)
      cat <<'USAGE'
Usage: strata-install [--enable-sddm]

Installs the Strata desktop from the configured static DNF repository.

  --enable-sddm    Enable SDDM and set graphical.target after installation.

When run as a normal user, the installer also applies Strata's user
configuration and personal dotfiles for that user without replacing existing
configuration files.
USAGE
      exit 0
      ;;
    *)
      echo "Unknown option: $argument" >&2
      exit 2
      ;;
  esac
done

if (( EUID != 0 )); then
  export STRATA_INSTALL_USER=${install_user:-$USER}
  exec sudo --preserve-env=STRATA_REPO_URL,STRATA_INSTALL_USER,STRATA_DOTFILES_REPO,STRATA_DOTFILES_DIR "$0" "$@"
fi

repo_file=/etc/yum.repos.d/strata.repo
install -d -m 0755 /etc/yum.repos.d
curl --fail --location --silent --show-error "$repo_url/strata.repo" -o "$repo_file"

# Strata uses the maintained tagged Quickshell build, rather than a
# development snapshot, because Fedora's base package may lag its API.
dnf copr enable -y errornointernet/quickshell


# Bootstrap in layers. Installing the desktop meta-package first can hide the
# useful dependency error behind its noarch wrapper; establish the compositor
# and Strata session core before requesting services and applications.
dnf install -y --refresh --setopt=install_weak_deps=False \
  hyprland hyprland-desktop-core git

# The full desktop meta-package then adds the independently versioned services
# and application layers. strata-config is last because it activates defaults
# for the installed desktop rather than supplying the runtime itself.
dnf install -y --refresh --setopt=install_weak_deps=False \
  hyprland-desktop strata-config

# `dnf install` intentionally leaves an installed package alone. Follow the
# bootstrap with an explicit upgrade so rerunning this script updates an
# existing Strata machine to the newest repository release as well.
dnf upgrade -y --refresh --setopt=install_weak_deps=False \
  hyprland-desktop strata-config

if [[ -n $install_user ]]; then
  if ! id "$install_user" >/dev/null 2>&1; then
    echo "Requested desktop user does not exist: $install_user" >&2
    exit 2
  fi
  install_home=$(getent passwd "$install_user" | cut -d: -f6)
  runuser -u "$install_user" -- env HOME="$install_home" \
    XDG_CONFIG_HOME="$install_home/.config" strata-apply-config

  # Strata ships and configures Zsh as its interactive shell. This is an
  # installer responsibility rather than an RPM scriptlet: RPM packages must
  # not silently alter the login shell of every account on a system.
  current_shell=$(getent passwd "$install_user" | cut -d: -f7)
  if [[ $current_shell != /usr/bin/zsh ]]; then
    usermod -s /usr/bin/zsh "$install_user"
    echo "Set $install_user's login shell to Zsh."
  fi

  # Personal dotfiles remain a separate, portable repository. Clone it into
  # the conventional personal project location on a first install; on later
  # runs only fast-forward an existing Git checkout and never replace an
  # unrelated directory.
  dotfiles_dir=${STRATA_DOTFILES_DIR:-"$install_home/Project/dotfiles"}
  dotfiles_ready=0
  if [[ -d $dotfiles_dir/.git ]]; then
    if runuser -u "$install_user" -- env HOME="$install_home" git -C "$dotfiles_dir" pull --ff-only; then
      dotfiles_ready=1
    else
      echo "Could not update dotfiles at $dotfiles_dir; leaving the existing checkout untouched." >&2
    fi
  elif [[ -e $dotfiles_dir ]]; then
    echo "Not replacing existing non-Git dotfiles directory: $dotfiles_dir" >&2
  else
    runuser -u "$install_user" -- install -d "$(dirname "$dotfiles_dir")"
    if runuser -u "$install_user" -- env HOME="$install_home" git clone "$dotfiles_repo" "$dotfiles_dir"; then
      dotfiles_ready=1
    else
      echo "Could not clone personal dotfiles from $dotfiles_repo." >&2
    fi
  fi

  if (( dotfiles_ready )); then
    runuser -u "$install_user" -- env HOME="$install_home" \
      XDG_CONFIG_HOME="$install_home/.config" bash "$dotfiles_dir/install.sh"
  fi
else
  echo "No desktop user was detected; run strata-apply-config after logging in."
fi

if (( enable_sddm )); then
  systemctl enable --force sddm.service
  systemctl set-default graphical.target
fi

cat <<'DONE'

Strata is installed. Reboot or log in through the Hyprland/UWSM session in SDDM.
DONE
