#!/usr/bin/env bash
set -euo pipefail

repo_url=${STRATA_REPO_URL:-https://name-is-hai.github.io/strata}
enable_sddm=0

for argument in "$@"; do
  case "$argument" in
    --enable-sddm) enable_sddm=1 ;;
    -h|--help)
      cat <<'USAGE'
Usage: strata-install [--enable-sddm]

Installs the Strata desktop from the configured static DNF repository.

  --enable-sddm    Enable SDDM and set graphical.target after installation.
USAGE
      exit 0
      ;;
    *)
      echo "Unknown option: $argument" >&2
      exit 2
      ;;
  esac
done

if (( EUID != 0 )); then
  exec sudo --preserve-env=STRATA_REPO_URL "$0" "$@"
fi

repo_file=/etc/yum.repos.d/strata.repo
install -d -m 0755 /etc/yum.repos.d
curl --fail --location --silent --show-error "$repo_url/strata.repo" -o "$repo_file"

# Strata uses the maintained tagged Quickshell build, rather than a
# development snapshot, because Fedora's base package may lag its API.
dnf copr enable -y errornointernet/quickshell

# Bootstrap in layers. Installing the desktop meta-package first can hide the
# useful dependency error behind its noarch wrapper; establish the compositor
# and Strata session core before requesting services and applications.
dnf install -y --refresh --setopt=install_weak_deps=False \
  hyprland hyprland-desktop-core

# The full desktop meta-package then adds the independently versioned services
# and application layers. strata-config is last because it activates defaults
# for the installed desktop rather than supplying the runtime itself.
dnf install -y --refresh --setopt=install_weak_deps=False \
  hyprland-desktop strata-config

if (( enable_sddm )); then
  systemctl enable --force sddm.service
  systemctl set-default graphical.target
fi

cat <<'DONE'

Strata is installed.
Run `strata-apply-config` as the desktop user, then reboot or log in through
the Hyprland/UWSM session in SDDM.
DONE
