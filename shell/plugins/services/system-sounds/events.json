{
  "//": "The built-in events. Each id is also the file name a sound theme provides (bell.ogg, device-added.wav, ...). When a theme lacks that file, the fallback names are tried in order, so freedesktop sound themes work too.",
  "events": [
    {
      "id": "startup",
      "label": "Startup",
      "windows": "Windows Startup",
      "glyph": "󰐥",
      "default": true,
      "trigger": "Signing in to the desktop",
      "fallback": [
        "desktop-login",
        "service-login",
        "system-ready"
      ],
      "requires": ""
    },
    {
      "id": "shutdown",
      "label": "Shut down",
      "windows": "Exit Windows",
      "glyph": "󰤆",
      "default": false,
      "trigger": "Powering off or restarting",
      "fallback": [
        "desktop-logout",
        "service-logout",
        "system-shutdown"
      ],
      "requires": ""
    },
    {
      "id": "bell",
      "label": "Default beep",
      "windows": "Default Beep",
      "glyph": "󰌌",
      "default": true,
      "trigger": "Backspace with nothing to delete, a terminal bell, any app ringing the system bell",
      "fallback": [
        "bell-window-system",
        "bell-terminal"
      ],
      "requires": ""
    },
    {
      "id": "audio-volume-change",
      "label": "Volume change",
