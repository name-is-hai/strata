{
  "schemaVersion": 1,
  "id": "strata.keyboard-osd",
  "name": "Keyboard OSD",
  "version": "1.3.0",
  "author": "Strata / 0x1ocean / trinity-bytes",
  "license": "MIT",
  "description": "One keyboard feedback service for US/VN, XKB layouts, Caps Lock, and Num Lock.",
  "kinds": [
    "service"
  ],
  "entryPoints": {
    "service": "Service.qml"
  },
  "settings": {
    "displayName": "Keyboard OSD",
    "defaults": {
      "labelStyle": "full",
      "durationMs": 800,
      "showIcon": true
    },
    "schema": [
      {
        "key": "labelStyle",
        "type": "enum",
        "label": "Label style",
        "description": "Show the full layout name, its language code, or its XKB layout code.",
        "options": [
          {
            "value": "full",
            "label": "Full"
          },
          {
            "value": "language",
            "label": "Language"
          },
          {
            "value": "layout",
            "label": "Layout"
          }
        ],
        "defaultValue": "full"
      },
      {
        "key": "durationMs",
        "type": "integer",
        "label": "Duration (ms)",
        "min": 200,
        "max": 5000,
        "step": 100,
        "defaultValue": 800
      },
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show keyboard icon",
        "defaultValue": true
      }
    ]
  },
  "keepLoaded": true
}
