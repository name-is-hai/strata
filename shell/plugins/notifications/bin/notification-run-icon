#!/usr/bin/python3
"""Regular launcher, not a symlink: The plugin loader rejects
symlinks inside a plugin directory. Execs the one sandbox implementation
in notification-run-helper with an explicit kind; no logic lives here."""
import os
import sys

helper = os.path.join(
    os.path.dirname(os.path.realpath(__file__)),
    "notification-run-helper"
)

os.execv(helper, [helper, "icon", *sys.argv[1:]])
