{
  "version": 1,
  "idle": {
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "strata.clock",
    "layout": {
      "left": [
        {
          "id": "strata.menu"
        },
        {
          "id": "strata.workspaces"
        }
      ],
      "center": [
        {
          "id": "strata.indicators"
        },
        {
          "id": "strata.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "strata.keyboard-layout"
        }
      ],
      "right": [
        {
          "id": "strata.tray"
        },
        {
          "id": "strata.bluetooth"
        },
        {
          "id": "strata.network"
        },
        {
          "id": "strata.audio"
        },
        {
          "id": "strata.monitor"
        },
        {
          "id": "strata.power"
        }
      ]
    }
  },
  "plugins": []
}
