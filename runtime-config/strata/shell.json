{
  "version": 1,
  "idle": {
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "strata.clock",
    "layout": {
      "left": [
        {
          "id": "strata.menu"
        },
        {
          "id": "strata.system-update"
        },
        {
          "id": "strata.workspaces"
        },
        {
          "id": "strata.stage-control"
        }
      ],
      "center": [
        {
          "id": "strata.indicators"
        },
        {
          "id": "strata.clock",
          "format": "d MMM yyyy HH:mm:ss",
          "formatAlt": "d MMM yyyy HH:mm:ss",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "strata.language-input"
        }
      ],
      "right": [
        {
          "id": "strata.tray"
        },
        {
          "id": "strata.notifications",
          "badge": "Highlight",
          "alwaysShow": false,
          "allowDefaultActionOnCardClick": true
        },
        {
          "id": "strata.bluetooth",
          "settingsCommand": "blueman-manager"
        },
        {
          "id": "strata.network",
          "settingsCommand": "nm-connection-editor"
        },
        {
          "id": "strata.media"
        },
        {
          "id": "strata.audio"
        },
        {
          "id": "strata.cast",
          "discoveryEnabled": false,
          "lastTab": "screen"
        },
        {
          "id": "strata.mouse"
        },
        {
          "id": "strata.power"
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "strata.microphone"
  ]
}
