{
  // Minimal Fedora-native desktop menu. Optional features are separate RPMs.
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "trigger": {"icon":"󱓞","label":"Tools"},
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"strata-menu-emoji"},
  "trigger.clipboard": {"icon":"","label":"Clipboard","action":"strata-menu-clipboard"},
  "trigger.capture": {"icon":"","label":"Capture"},
  "trigger.capture.screenshot": {"icon":"󰹑","label":"Screenshot","action":"strata-capture-screenshot"},
  "trigger.capture.screenrecord": {"icon":"󰻂","label":"Screen recording"},
  "trigger.capture.screenrecord.area": {"icon":"󰩬","label":"Select area"},
  "trigger.capture.screenrecord.area.no-audio": {"icon":"󰍭","label":"No audio","action":"strata-capture-screenrecording"},
  "trigger.capture.screenrecord.area.desktop-audio": {"icon":"󰕾","label":"Desktop audio","action":"strata-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.area.desktop-and-mic": {"icon":"󰍬","label":"Desktop + microphone","action":"strata-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.fullscreen": {"icon":"󰍹","label":"Full screen"},
  "trigger.capture.screenrecord.fullscreen.no-audio": {"icon":"󰍭","label":"No audio","action":"strata-capture-screenrecording --fullscreen"},
  "trigger.capture.screenrecord.fullscreen.desktop-audio": {"icon":"󰕾","label":"Desktop audio","action":"strata-capture-screenrecording --fullscreen --with-desktop-audio"},
  "trigger.capture.screenrecord.fullscreen.desktop-and-mic": {"icon":"󰍬","label":"Desktop + microphone","action":"strata-capture-screenrecording --fullscreen --with-desktop-audio --with-microphone-audio"},
  "trigger.color": {"icon":"󰃉","label":"Color picker","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"strata-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"strata-toggle-notification-silencing"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"strata-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"strata-toggle-bar"},

  "open": {"icon":"󰏌","label":"Open"},
  "open.terminal": {"icon":"","label":"Terminal","action":"uwsm-app -- ghostty"},
  "open.files": {"icon":"","label":"Files","action":"strata-launch-nautilus"},
  "open.system-monitor": {"icon":"󰍛","label":"System Monitor","action":"uwsm-app -- ghostty -e btop"},

  "setup": {"icon":"","label":"Settings","aliases":["settings"]},
  "setup.network": {"icon":"󰛳","label":"Network","action":"strata-shell shell summon strata.network '{}'"},
  "setup.bluetooth": {"icon":"󰂯","label":"Bluetooth","action":"strata-shell shell summon strata.bluetooth '{}'"},
  "setup.audio": {"icon":"󰕾","label":"Audio","action":"strata-shell shell summon strata.audio '{}'"},
  "setup.display": {"icon":"󰍹","label":"Display","action":"strata-shell shell summon strata.monitor '{}'"},
  "setup.power": {"icon":"󰐥","label":"Power","action":"strata-shell shell summon strata.power '{}'"},
  "setup.hyprland": {"icon":"","label":"Hyprland config","action":"uwsm-app -- ghostty -e nvim $HOME/.config/hypr/hyprland.lua"},

  "system": {"icon":"","label":"System","aliases":["power-menu"]},
  "system.lock": {"icon":"","label":"Lock","action":"strata-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","action":"systemctl suspend"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"strata-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"strata-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"strata-system-shutdown"}
}
